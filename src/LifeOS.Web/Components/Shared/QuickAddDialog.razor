@inherits PlanningComponentBase
@using LifeOS.Application.Organize
@inject TaskService Tasks

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_title" Label="@L["QuickAdd_Label"]" HelperText="@L["QuickAdd_Hint"]"
                      Immediate="true" AutoFocus="true" MaxLength="@TaskService.MaxTitleLength"
                      OnKeyDown="OnKeyDown" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync"
                   Disabled="@string.IsNullOrWhiteSpace(_title)">@L["Add"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private string _title = string.Empty;

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_title))
        {
            return;
        }

        if (await RunAsync(() => Tasks.CaptureAsync(_title)))
        {
            Snackbar.Add(L["QuickAdd_Saved"], Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SaveAsync();
        }
    }
}
