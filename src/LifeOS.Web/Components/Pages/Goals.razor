@page "/goals"
@attribute [Authorize]
@inherits PlanningComponentBase
@using LifeOS.Application.Abstractions
@using LifeOS.Application.Goals
@using LifeOS.Domain.Goals
@inject GoalService GoalsApi
@inject IUserClock Clock
@inject NavigationManager Navigation

<PageTitle>@L["Nav_Goals"] – @L["App_Title"]</PageTitle>

<div class="d-flex align-center flex-wrap gap-2 mb-3">
    <MudText Typo="Typo.h5" Tag="@("h1")">@L["Nav_Goals"]</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="NewAsync">@L["Goals_New"]</MudButton>
</div>

<div class="subnav" role="tablist">
    <button type="button" role="tab" aria-selected="@(_scope is null)" class="@(_scope is null ? "active" : null)"
            @onclick="() => SetScopeAsync(null)">@L["Goals_All"]</button>
    @foreach (var h in Enum.GetValues<GoalHorizon>())
    {
        var horizon = h;
        <button type="button" role="tab" aria-selected="@(_scope == horizon)" class="@(_scope == horizon ? "active" : null)"
                @onclick="() => SetScopeAsync(horizon)">@L["Horizon_" + horizon]</button>
    }
</div>

@if (_scope is { } scope)
{
    <div class="sprint-header">
        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" aria-label="@L["Goals_PeriodPrev"]" OnClick="() => ShiftAsync(-1)" />
        <div class="sprint-title">
            <MudText Typo="Typo.h5">@GoalDialog.PeriodText(scope, _periodStart)</MudText>
        </div>
        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" aria-label="@L["Goals_PeriodNext"]" OnClick="() => ShiftAsync(1)" />
        @if (_periodStart != GoalPeriods.Start(scope, Clock.Today))
        {
            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="TodayAsync">@L["Sprint_ThisWeek"]</MudButton>
        }
    </div>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">@L["Goals_ScopeHint_" + scope]</MudText>
}

<MudSwitch T="bool" Value="_showClosed" ValueChanged="ShowClosedChangedAsync" Label="@L["Goals_ShowInactive"]" Color="Color.Primary" Class="mb-2" />

@if (_goals is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_goals.Count == 0)
{
    <MudPaper Outlined="true" Class="pa-6 text-center">
        <MudText Color="Color.Secondary">@L["Goals_Empty"]</MudText>
    </MudPaper>
}
else
{
    <GoalTree Goals="_goals" OnOpen="Open"
              ShowYearHeading="@(_scope is null)"
              ShowQuarterHeading="@(_scope is null or GoalHorizon.Year)"
              ShowMonthHeading="@(_scope is not GoalHorizon.Month)" />
}

@code {
    /// <summary>The chosen period type, or null for every goal. Defaults to the year, which brings its quarters and months with it.</summary>
    private GoalHorizon? _scope = GoalHorizon.Year;
    private GoalHorizon CurrentHorizon => _scope ?? GoalHorizon.Quarter;
    private DateOnly _periodStart;
    private bool _showClosed;
    private IReadOnlyList<GoalView>? _goals;

    protected override async Task OnInitializedAsync()
    {
        _periodStart = GoalPeriods.Start(CurrentHorizon, Clock.Today);
        await ReloadAsync();
    }

    private async Task ReloadAsync() =>
        _goals = await GoalsApi.ListWithinAsync(_scope, _scope is null ? null : _periodStart, _showClosed);

    private async Task SetScopeAsync(GoalHorizon? scope)
    {
        _scope = scope;
        _periodStart = GoalPeriods.Start(CurrentHorizon, Clock.Today);
        await ReloadAsync();
    }

    private async Task ShiftAsync(int periods)
    {
        _periodStart = GoalPeriods.Shift(CurrentHorizon, _periodStart, periods);
        await ReloadAsync();
    }

    private async Task TodayAsync()
    {
        _periodStart = GoalPeriods.Start(CurrentHorizon, Clock.Today);
        await ReloadAsync();
    }

    private async Task ShowClosedChangedAsync(bool value)
    {
        _showClosed = value;
        await ReloadAsync();
    }

    private void Open(GoalView goal) => Navigation.NavigateTo($"goals/{goal.Id}");

    private async Task NewAsync()
    {
        var parameters = new DialogParameters<GoalDialog>
        {
            { x => x.DefaultHorizon, CurrentHorizon },
            { x => x.DefaultPeriodStart, _periodStart },
        };
        var result = await ShowDialogAsync<GoalDialog>(L["Goals_New"], parameters);
        if (result?.Data is Guid id)
        {
            Navigation.NavigateTo($"goals/{id}");
        }
    }
}
