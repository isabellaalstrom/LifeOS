@page "/"
@attribute [Authorize]
@inherits PlanningComponentBase
@implements IDisposable
@using LifeOS.Application.Abstractions
@using LifeOS.Application.Organize
@using LifeOS.Application.Planning
@using LifeOS.Domain.Planning
@using LifeOS.Domain.Tasks
@inject TodayService TodayService
@inject TaskService Tasks
@inject IUserClock Clock
@inject NavigationManager Navigation
@inject LifeOS.Application.Goals.GoalService GoalsApi
@inject LifeOS.Application.Habits.HabitService HabitsApi
@inject LifeOS.Application.Retros.RetroService RetrosApi

<PageTitle>@L["Nav_Today"] – @L["App_Title"]</PageTitle>

@if (_view is null || _today is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    @* ---- greeting ---- *@
    <section class="hero">
        <div class="hero-text">
            <h1 class="hero-title">@Greeting</h1>
            <p class="hero-sub">
                @L["Sprint_Week", _view.Sprint.IsoWeek]
                @if (!string.IsNullOrWhiteSpace(_view.Sprint.Goal))
                {
                    <text> · @_view.Sprint.Goal</text>
                }
                else
                {
                    <text> · @L["Hero_Tagline"]</text>
                }
            </p>
        </div>
        <svg class="hero-art" viewBox="0 0 460 170" preserveAspectRatio="xMaxYMax slice" aria-hidden="true">
            <circle cx="378" cy="50" r="26" fill="#F5CF6B" />
            <circle cx="369" cy="46" r="2.4" fill="#7A5A1E" />
            <circle cx="387" cy="46" r="2.4" fill="#7A5A1E" />
            <path d="M368 56 Q378 65 388 56" stroke="#7A5A1E" stroke-width="2.4" fill="none" stroke-linecap="round" />
            <rect x="250" y="32" width="64" height="12" rx="6" fill="#FFFFFF" opacity="0.75" />
            <rect x="282" y="48" width="44" height="10" rx="5" fill="#FFFFFF" opacity="0.6" />
            <path d="M0 150 C 70 96, 150 98, 230 128 S 380 150, 460 108 L460 170 L0 170 Z" fill="#B9D3B2" />
            <path d="M0 160 C 90 120, 170 126, 250 146 S 400 160, 460 134 L460 170 L0 170 Z" fill="#9FC49A" />
            <path d="M120 170 C 190 150, 250 156, 330 170 Z" fill="#E8DDB8" opacity="0.9" />
            <path d="M0 170 C 100 150, 190 160, 280 168 S 420 168, 460 160 L460 170 Z" fill="#86B287" />
        </svg>
    </section>

    @if (!_hasAnyGoal)
    {
        <OnboardingCard OnGoalCreated="ReloadAsync" />
    }

    @* ---- gentle retro suggestions: last month, quarter and year, when it is time ---- *@
    @foreach (var suggestion in _retroSuggestions)
    {
        var s = suggestion;
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" ShowCloseIcon="false">
            @L["Retros_Suggest", Fmt.RetroPeriod(L, s.Type, s.PeriodStart)]
            <MudButton Size="Size.Small" Class="ml-2" OnClick="() => StartRetroAsync(s)">@L["Retros_Start"]</MudButton>
        </MudAlert>
    }

    @foreach (var past in _view.PastSprintsToClose)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" ShowCloseIcon="false">
            @L["Sprint_PastHint", past.IsoWeek, past.OpenTasks]
            <MudButton Size="Size.Small" Class="ml-2" Href="@($"planning?week={past.WeekStart:yyyy-MM-dd}")">@L["Sprint_PastOpen"]</MudButton>
        </MudAlert>
    }

    <MudGrid Spacing="3">
        <MudItem xs="12" md="7">
            @* ---- today's focus ---- *@
            <div class="d-flex align-center gap-2 mb-1">
                <MudText Typo="Typo.h6" Tag="@("h2")">@L["Today_Focus"]</MudText>
                @if (_today.Focus.Count > 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Today_Done", _today.Focus.Count(t => t.Status == TaskItemStatus.Done), _today.Focus.Count]</MudText>
                }
            </div>
            @if (_today.Focus.Count == 0)
            {
                <MudPaper Outlined="true" Class="pa-4 mb-3"><MudText Color="Color.Secondary">@L["Today_FocusEmpty"]</MudText></MudPaper>
            }
            @foreach (var t in _today.Focus)
            {
                <TaskRow Item="t" Today="_today.Date" OnOpen="OpenAsync" OnToggle="ToggleAsync">
                    <Actions>
                        @if (t.FocusDate == _today.Date)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" aria-label="@L["Task_RemoveFocus"]"
                                           OnClick="() => SetFocusAsync(t, false)" />
                        }
                    </Actions>
                </TaskRow>
            }

            @* ---- recurring: tick off from here ---- *@
            @if (_habits.Count > 0)
            {
                <MudText Typo="Typo.h6" Tag="@("h2")" Class="mt-4 mb-1">@L["Habit_Today"]</MudText>
                @foreach (var h in _habits)
                {
                    <div class="task-row @(h.TargetMet ? "is-done" : null)">
                        <div class="task-main" role="link" tabindex="0" @onclick='() => Navigation.NavigateTo($"habits/{h.Id}")'>
                            <span class="task-title">@h.Name</span>
                            <span class="task-meta">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Icon="@Icons.Material.Filled.Repeat">@L["Habit_Progress", h.CountInPeriod, h.TargetCount] · @L["Habit_Every_" + h.Period, h.TargetCount]</MudChip>
                                @if (h.Streak > 0)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Icon="@Icons.Material.Filled.LocalFireDepartment">@L["Habit_Streak_" + h.Period, h.Streak]</MudChip>
                                }
                            </span>
                        </div>
                        <div class="task-actions">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="() => LogHabitAsync(h)">@L["Habit_Log"]</MudButton>
                        </div>
                    </div>
                }
            }

            @* ---- due / overdue ---- *@
            @if (_today.DueOrOverdue.Count > 0)
            {
                <MudText Typo="Typo.h6" Tag="@("h2")" Class="mt-4 mb-1">@L["Today_Due"]</MudText>
                @foreach (var t in _today.DueOrOverdue)
                {
                    <TaskRow Item="t" Today="_today.Date" OnOpen="OpenAsync" OnToggle="ToggleAsync">
                        <Actions>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => SetFocusAsync(t, true)">@L["Today_AddFocus"]</MudButton>
                        </Actions>
                    </TaskRow>
                }
            }

            @* ---- from this week's plan ---- *@
            <MudText Typo="Typo.h6" Tag="@("h2")" Class="mt-4 mb-1">@L["Today_Suggestions"]</MudText>
            @if (_today.SprintSuggestions.Count == 0)
            {
                <MudText Color="Color.Secondary">@L["Today_NoSuggestions"]</MudText>
            }
            @foreach (var t in _today.SprintSuggestions)
            {
                <TaskRow Item="t" Today="_today.Date" OnOpen="OpenAsync" OnToggle="ToggleAsync">
                    <Actions>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => SetFocusAsync(t, true)">@L["Today_AddFocus"]</MudButton>
                    </Actions>
                </TaskRow>
            }
        </MudItem>

        <MudItem xs="12" md="5">
            @* ---- the week ---- *@
            <div class="tone-card tone-sky mb-3">
                <p class="card-eyebrow">@L["Nav_Planning"]</p>
                <h2 class="card-title">@L["Sprint_Week", _view.Sprint.IsoWeek]</h2>
                @if (!_view.Sprint.Exists)
                {
                    <MudText Color="Color.Secondary" Class="my-2">@L["Overview_NoSprint"]</MudText>
                    <MudButton Href="planning" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium">@L["Overview_PlanWeek"]</MudButton>
                }
                else
                {
                    var s = _view.Sprint;
                    var total = s.ToDo + s.InProgress + s.Done;
                    <MudText Class="my-1">@(string.IsNullOrWhiteSpace(s.Goal) ? L["Sprint_NoGoal"] : s.Goal)</MudText>
                    @if (total > 0)
                    {
                        <MudProgressLinear Value="@(s.Done * 100.0 / total)" Color="Color.Primary" Rounded="true" Size="Size.Medium" Class="my-2" />
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @L["Overview_Sprint_Progress", s.Done, total] · @L["Status_ToDo"] @s.ToDo · @L["Status_InProgress"] @s.InProgress
                        </MudText>
                    }
                    @if (s.Capacity != CapacityStatus.NotSet)
                    {
                        <MudText Typo="Typo.caption" Color="@(s.Capacity is CapacityStatus.Over or CapacityStatus.NearLimit ? Color.Warning : Color.Secondary)" Class="d-block">
                            @L["Sprint_Planned", Fmt.Duration(L, s.PlannedMinutes), Fmt.Duration(L, s.CapacityMinutes)]
                        </MudText>
                    }
                    <MudButton Href="planning" Variant="Variant.Text" Size="Size.Small" Class="mt-2">@L["Overview_OpenSprint"]</MudButton>
                }
            </div>

            @* ---- goals ---- *@
            <div class="tone-card tone-lavender mb-3">
                <p class="card-eyebrow">@L["Nav_Goals"]</p>
                <h2 class="card-title">@L["Overview_Goals"]</h2>
                @if (_goals.Count == 0)
                {
                    <MudText Color="Color.Secondary" Class="my-2">@L["Overview_GoalsEmpty"]</MudText>
                }
                @foreach (var g in _goals)
                {
                    <a href="@($"goals/{g.Id}")" class="mini-progress">
                        <span class="mini-progress-head"><span>@g.Title</span><span>@g.Percent.ToString("0") %</span></span>
                        <MudProgressLinear Value="@((double)g.Percent)" Color="Color.Primary" Rounded="true" />
                    </a>
                }
                <MudButton Href="goals" Variant="Variant.Text" Size="Size.Small" Class="mt-1">@L["Overview_OpenGoals"]</MudButton>
            </div>

            @* ---- AI insight: on demand, cached ---- *@
            <AiInsightCard />
        </MudItem>
    </MudGrid>

    @* ---- the rest of the app, one tap away ---- *@
    <nav class="shortcuts" aria-label="@L["Shortcuts"]">
        <MudButton Href="habits" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Repeat">@L["Nav_Habits"]</MudButton>
        <MudButton Href="areas" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Sell">@L["Areas_Title"]</MudButton>
        <MudButton Href="retros" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Insights">@L["Nav_Retros"]</MudButton>
        <MudButton Href="guide" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.HelpOutline">@L["Guide_Title"]</MudButton>
    </nav>
}

@code {
    private OverviewView? _view;
    private TodayView? _today;
    private IReadOnlyList<LifeOS.Application.Goals.GoalView> _goals = [];
    private IReadOnlyList<LifeOS.Application.Habits.HabitView> _habits = [];
    private IReadOnlyList<LifeOS.Application.Retros.RetroSuggestion> _retroSuggestions = [];
    private bool _hasAnyGoal = true;

    [Inject] private LifeOS.Web.Services.AppEvents Events { get; set; } = default!;

    private string Greeting
    {
        get
        {
            var hour = TimeZoneInfo.ConvertTime(Clock.UtcNow, Clock.Zone).Hour;
            return hour switch
            {
                >= 5 and < 12 => L["Hero_Morning"],
                >= 12 and < 18 => L["Hero_Afternoon"],
                >= 18 and < 23 => L["Hero_Evening"],
                _ => L["Hero_Night"],
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Events.TasksChanged += OnTasksChangedAsync;
        // Recurring items put their tasks into the week plan by themselves.
        await HabitsApi.EnsureWeekTasksAsync(Clock.Today);
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _view = await TodayService.GetOverviewAsync();
        _today = await TodayService.GetTodayAsync();
        _goals = await GoalsApi.ListCurrentAsync();
        _hasAnyGoal = _goals.Count > 0 || (await GoalsApi.ListAsync(includeClosed: true)).Count > 0;
        _habits = await HabitsApi.ListAsync();
        _retroSuggestions = await RetrosApi.SuggestionsAsync();
    }

    private async Task OnTasksChangedAsync()
    {
        await ReloadAsync();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Events.TasksChanged -= OnTasksChangedAsync;

    private async Task StartRetroAsync(LifeOS.Application.Retros.RetroSuggestion suggestion)
    {
        var id = await RetrosApi.StartOrResumeAsync(suggestion.Type, suggestion.PeriodStart);
        Navigation.NavigateTo($"retros/{id}");
    }

    private async Task LogHabitAsync(LifeOS.Application.Habits.HabitView habit)
    {
        await RunAsync(() => HabitsApi.LogAsync(habit.Id));
        await ReloadAsync();
    }

    private async Task SetFocusAsync(TaskView task, bool focus)
    {
        await RunAsync(() => Tasks.SetFocusAsync(task.Id, focus ? _today!.Date : null));
        await ReloadAsync();
    }

    private async Task ToggleAsync((TaskView Item, bool Done) change)
    {
        await RunAsync(() => Tasks.SetStatusAsync(change.Item.Id, change.Done ? TaskItemStatus.Done : TaskItemStatus.ToDo));
        await ReloadAsync();
    }

    private async Task OpenAsync(TaskView task)
    {
        if (await ShowDialogAsync<TaskDialog>(L["Task_Edit"], new DialogParameters<TaskDialog> { { x => x.TaskId, task.Id } }) is not null)
        {
            await ReloadAsync();
        }
    }
}
