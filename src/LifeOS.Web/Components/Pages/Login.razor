@page "/login"
@layout AuthLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using System.ComponentModel.DataAnnotations
@using LifeOS.Infrastructure.Identity
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Login_Title"] – @L["App_Title"]</PageTitle>
<h1>@L["Login_Title"]</h1>

@if (_error is not null)
{
    <p class="form-error" role="alert">@_error</p>
}

<EditForm Model="Input" method="post" OnValidSubmit="LoginAsync" FormName="login">
    <DataAnnotationsValidator />
    <label>@L["Login_Email"]
        <InputText type="email" @bind-Value="Input.Email" autocomplete="username" class="field" />
    </label>
    <label>@L["Login_Password"]
        <InputText type="password" @bind-Value="Input.Password" autocomplete="current-password" class="field" />
    </label>
    <button type="submit" class="btn-primary">@L["Login_Submit"]</button>
</EditForm>

@code {
    private string? _error;

    [SupplyParameterFromForm] private LoginModel Input { get; set; } = default!;

    protected override void OnInitialized()
    {
        Input ??= new();

        // Before the owner exists, send the visitor to first-run setup.
        if (!UserManager.Users.Any())
        {
            Navigation.NavigateTo("setup");
        }
    }

    private async Task LoginAsync()
    {
        var result = await SignInManager.PasswordSignInAsync(Input.Email, Input.Password, isPersistent: true, lockoutOnFailure: true);
        if (result.Succeeded)
        {
            // Relative URL keeps the ingress path base.
            Navigation.NavigateTo("");
            return;
        }

        _error = result.IsLockedOut ? L["Login_LockedOut"] : L["Login_Invalid"];
    }

    private sealed class LoginModel
    {
        [Required, EmailAddress] public string Email { get; set; } = "";
        [Required] public string Password { get; set; } = "";
    }
}
