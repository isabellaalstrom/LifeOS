@page "/guide"
@attribute [Authorize]
@inherits PlanningComponentBase

<PageTitle>@L["Guide_Title"] – @L["App_Title"]</PageTitle>

<MudText Typo="Typo.h5" Tag="@("h1")">@L["Guide_Title"]</MudText>
<MudText Color="Color.Secondary" Class="mb-3">@L["Guide_Intro"]</MudText>

<section class="tone-card tone-sage my-3">
    <h2 class="card-title">@L["Guide_Blocks"]</h2>
    <dl class="guide-words">
        <dt>@L["Guide_Task"]</dt><dd>@L["Guide_TaskText"]</dd>
        <dt>@L["Guide_Goal"]</dt><dd>@L["Guide_GoalText"]</dd>
        <dt>@L["Guide_Recurring"]</dt><dd>@L["Guide_RecurringText"]</dd>
    </dl>
</section>

<section class="tone-card tone-sky my-3">
    <h2 class="card-title">@L["Guide_Views"]</h2>
    <ul class="guide-list">
        <li>@L["Guide_ViewToday"]</li>
        <li>@L["Guide_ViewWeek"]</li>
        <li>@L["Guide_ViewBacklog"]</li>
    </ul>
</section>

<section class="tone-card tone-lavender my-3">
    <h2 class="card-title">@L["Guide_Extras"]</h2>
    <MudText Class="mb-1">@L["Guide_CategoriesText"]</MudText>
    <MudText>@L["Guide_RetroText"]</MudText>
</section>

<section class="tone-card tone-butter my-3">
    <h2 class="card-title">@L["Guide_Minimum"]</h2>
    <MudText>@L["Guide_MinimumText"]</MudText>
</section>
