@inherits LayoutComponentBase
@inject IStringLocalizer<SharedResource> L
@inject IDialogService DialogService
@inject LifeOS.Web.Services.AppEvents Events
@inject LifeOS.Application.Abstractions.IUserClock Clock

<MudThemeProvider @ref="_themeProvider" Theme="_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true" Class="app-bar">
        <a href="" class="brand" aria-label="@L["App_Title"]">
            <span class="brand-mark" aria-hidden="true"></span>
            <span class="brand-name">@L["App_Title"]</span>
        </a>
        <MudSpacer />
        <span class="app-date">@_dateText</span>
        @* Quick capture from every page: one field, lands in the Inbox. *@
        <MudTooltip Text="@L["QuickAdd"]">
            <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline" Color="Color.Inherit"
                           OnClick="QuickAddAsync" aria-label="@L["QuickAdd"]" />
        </MudTooltip>
        <form method="post" action="account/logout" class="d-inline-flex">
            <AntiforgeryToken />
            <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" ButtonType="ButtonType.Submit"
                           aria-label="@L["Logout"]" />
        </form>
    </MudAppBar>

    @* Navigation is plain CSS-driven (side menu on wide screens, bottom bar on narrow ones) so it never depends on
       a live Blazor circuit or MudBlazor's JavaScript, which matters behind proxies such as HA ingress. *@
    <nav class="side-nav" aria-label="Huvudnavigering">
        <NavLink href="" Match="NavLinkMatch.All"><MudIcon Icon="@Icons.Material.Outlined.Dashboard" /><span>@L["Nav_Overview"]</span></NavLink>
        <NavLink href="goals"><MudIcon Icon="@Icons.Material.Outlined.Flag" /><span>@L["Nav_Goals"]</span></NavLink>
        <NavLink href="planning"><MudIcon Icon="@Icons.Material.Outlined.ViewKanban" /><span>@L["Nav_Planning"]</span></NavLink>
        <NavLink href="projects"><MudIcon Icon="@Icons.Material.Outlined.Folder" /><span>@L["Nav_Projects"]</span></NavLink>
        <NavLink href="habits"><MudIcon Icon="@Icons.Material.Outlined.Repeat" /><span>@L["Nav_Habits"]</span></NavLink>
        <NavLink href="retros"><MudIcon Icon="@Icons.Material.Outlined.Insights" /><span>@L["Nav_Retros"]</span></NavLink>
    </nav>

    <MudMainContent Class="main-content">
        <MudContainer MaxWidth="MaxWidth.Large" Class="page-container">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<nav class="bottom-nav" aria-label="Huvudnavigering">
    <NavLink href="" Match="NavLinkMatch.All"><MudIcon Icon="@Icons.Material.Outlined.Dashboard" /><span>@L["Nav_Overview"]</span></NavLink>
    <NavLink href="goals"><MudIcon Icon="@Icons.Material.Outlined.Flag" /><span>@L["Nav_Goals"]</span></NavLink>
    <NavLink href="planning"><MudIcon Icon="@Icons.Material.Outlined.ViewKanban" /><span>@L["Nav_Planning"]</span></NavLink>
    <NavLink href="projects"><MudIcon Icon="@Icons.Material.Outlined.Folder" /><span>@L["Nav_Projects"]</span></NavLink>
    <NavLink href="habits"><MudIcon Icon="@Icons.Material.Outlined.Repeat" /><span>@L["Nav_Habits"]</span></NavLink>
    <NavLink href="retros"><MudIcon Icon="@Icons.Material.Outlined.Insights" /><span>@L["Nav_Retros"]</span></NavLink>
</nav>

<div id="blazor-error-ui" data-nosnippet>
    Ett oväntat fel inträffade.
    <a href="." class="reload">Ladda om</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private MudThemeProvider? _themeProvider;
    private bool _isDarkMode;
    private string _dateText = string.Empty;

    private readonly MudTheme _theme = LifeOS.Web.Theming.LifeOsTheme.Create();

    protected override void OnInitialized() =>
        _dateText = Clock.Today.ToString("dddd d MMMM", System.Globalization.CultureInfo.CurrentCulture);

    private async Task QuickAddAsync()
    {
        var reference = await DialogService.ShowAsync<QuickAddDialog>(
            L["QuickAdd_Title"], new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small, CloseOnEscapeKey = true });
        var result = await reference.Result;
        if (result is { Canceled: false })
        {
            await Events.NotifyInboxChangedAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _themeProvider is not null)
        {
            _isDarkMode = await _themeProvider.GetSystemDarkModeAsync();
            StateHasChanged();
        }
    }
}
