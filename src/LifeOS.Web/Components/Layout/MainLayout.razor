@inherits LayoutComponentBase
@inject IStringLocalizer<SharedResource> L

<MudThemeProvider @ref="_themeProvider" Theme="_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true" Class="app-bar">
        <MudText Typo="Typo.h6">@L["App_Title"]</MudText>
        <MudSpacer />
        @* Quick capture lands in Phase 2; the entry point exists now so the shell layout is final. *@
        <MudTooltip Text="@L["QuickAdd"]">
            <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline" Color="Color.Inherit" Disabled="true"
                           aria-label="@L["QuickAdd"]" />
        </MudTooltip>
        <form method="post" action="account/logout" class="d-inline-flex">
            <AntiforgeryToken />
            <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" ButtonType="ButtonType.Submit"
                           aria-label="@L["Logout"]" />
        </form>
    </MudAppBar>

    @* Navigation is plain CSS-driven (side menu on wide screens, bottom bar on narrow ones) so it never depends on
       a live Blazor circuit or MudBlazor's JavaScript, which matters behind proxies such as HA ingress. *@
    <nav class="side-nav" aria-label="Huvudnavigering">
        <NavLink href="" Match="NavLinkMatch.All"><MudIcon Icon="@Icons.Material.Filled.Dashboard" /><span>@L["Nav_Overview"]</span></NavLink>
        <NavLink href="goals"><MudIcon Icon="@Icons.Material.Filled.Flag" /><span>@L["Nav_Goals"]</span></NavLink>
        <NavLink href="planning"><MudIcon Icon="@Icons.Material.Filled.ViewKanban" /><span>@L["Nav_Planning"]</span></NavLink>
        <NavLink href="projects"><MudIcon Icon="@Icons.Material.Filled.Folder" /><span>@L["Nav_Projects"]</span></NavLink>
        <NavLink href="habits"><MudIcon Icon="@Icons.Material.Filled.Repeat" /><span>@L["Nav_Habits"]</span></NavLink>
        <NavLink href="retros"><MudIcon Icon="@Icons.Material.Filled.Insights" /><span>@L["Nav_Retros"]</span></NavLink>
    </nav>

    <MudMainContent Class="main-content">
        <MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<nav class="bottom-nav" aria-label="Huvudnavigering">
    <NavLink href="" Match="NavLinkMatch.All"><MudIcon Icon="@Icons.Material.Filled.Dashboard" /><span>@L["Nav_Overview"]</span></NavLink>
    <NavLink href="goals"><MudIcon Icon="@Icons.Material.Filled.Flag" /><span>@L["Nav_Goals"]</span></NavLink>
    <NavLink href="planning"><MudIcon Icon="@Icons.Material.Filled.ViewKanban" /><span>@L["Nav_Planning"]</span></NavLink>
    <NavLink href="projects"><MudIcon Icon="@Icons.Material.Filled.Folder" /><span>@L["Nav_Projects"]</span></NavLink>
    <NavLink href="habits"><MudIcon Icon="@Icons.Material.Filled.Repeat" /><span>@L["Nav_Habits"]</span></NavLink>
    <NavLink href="retros"><MudIcon Icon="@Icons.Material.Filled.Insights" /><span>@L["Nav_Retros"]</span></NavLink>
</nav>

<div id="blazor-error-ui" data-nosnippet>
    Ett oväntat fel inträffade.
    <a href="." class="reload">Ladda om</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private MudThemeProvider? _themeProvider;
    private bool _isDarkMode;

    // System fonts only: no external font requests (works offline on a NAS, no third-party calls).
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight { Primary = "#3b6ea5", Secondary = "#667585" },
        PaletteDark = new PaletteDark { Primary = "#7fb0e6", Secondary = "#9aa7b5" },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["system-ui", "-apple-system", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"]
            }
        }
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _themeProvider is not null)
        {
            _isDarkMode = await _themeProvider.GetSystemDarkModeAsync();
            StateHasChanged();
        }
    }
}
